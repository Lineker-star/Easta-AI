# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/easta

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

FRONTEND_URL=http://localhost:5000

SESSION_SECRET=YOUR_SESSION_SECRET
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Google Sign-In (optional) ---
# Leave blank to leave "Continue with Google" hidden on login/register
# (GET /api/features -> google_signin: false). Create an OAuth 2.0
# Client ID (Web application) in Google Cloud Console -> APIs &
# Services -> Credentials, and add GOOGLE_REDIRECT_URI below as an
# "Authorized redirect URI" there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Model routing ---
# Fast/cheap model used for simple turns (tool-calling is skipped for
# this model — see EASTA_ENABLE_TOOLS below)
EASTA_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Frontier model used for complex turns (swap for any OpenRouter model id
# that supports tool/function calling if you rely on EASTA_ENABLE_TOOLS)
EASTA_SMART_MODEL=openai/gpt-4.1-mini
# Fallback model if both of the above fail or rate-limit
EASTA_FALLBACK_MODEL=meta-llama/llama-3.1-70b-instruct

# --- Vision (image input) ---
# Model used for turns with an image attachment (composer image picker
# or pasted screenshot). Must support image input on OpenRouter --
# check https://openrouter.ai/models before changing. Defaults to
# EASTA_SMART_MODEL if unset (openai/gpt-4.1-mini already supports
# vision as of writing).
EASTA_VISION_MODEL=openai/gpt-4.1-mini
# Cross-provider fallback if EASTA_VISION_MODEL errors/rate-limits --
# also must support image input.
EASTA_VISION_FALLBACK_MODEL=google/gemini-3.8-flash

# --- Image generation ---
# Model used by the generate_image tool. Uses OpenRouter's dedicated
# Image API (POST /api/v1/images), not chat completions -- check
# https://openrouter.ai/models for current image-output-capable models
# before changing.
EASTA_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Voice (server-side STT/TTS fallbacks) ---
# Only used when the browser's native SpeechRecognition/speechSynthesis
# APIs aren't available -- see EASTA_ENABLE_SERVER_STT/_TTS below and
# GET /api/features. Both go through OpenRouter's dedicated audio
# endpoints (POST /api/v1/audio/transcriptions, /api/v1/audio/speech),
# not chat completions -- check https://openrouter.ai/docs for current
# model ids before changing.
EASTA_STT_MODEL=openai/whisper-1
EASTA_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
EASTA_TTS_VOICE=alloy

# --- Rate limiting ---
EASTA_RATE_LIMIT_PER_MINUTE=20

# --- Feature flags (Phase 3) ---
# Tool use: lets the smart model call web_search / execute_python
# mid-answer. See backend/app.py -> TOOLS / execute_tool().
EASTA_ENABLE_TOOLS=true
# RAG: grounds answers in documents the user has added via
# POST /api/documents (keyword search over Postgres tsvector).
EASTA_ENABLE_RAG=true
# Context summarization: folds old turns into a running summary once a
# conversation grows past EASTA_CONTEXT_RECENT_MESSAGES.
EASTA_ENABLE_SUMMARIZATION=true
EASTA_CONTEXT_RECENT_MESSAGES=12
# Cross-conversation memory: extracts short, durable, explicitly-
# stated facts (never inferred) from messages that look like they
# might contain one, and injects them into every future conversation.
# See maybe_extract_memory() / build_memory_context_message() in
# backend/app.py, and the "Remembered" section on /account.
EASTA_ENABLE_MEMORY=true
# Research mode: the composer's "Research" toggle runs multiple search
# queries, reads the actual top pages, and cites sources inline. See
# run_research() in backend/app.py.
EASTA_ENABLE_RESEARCH_MODE=true
# Generation: the generate_document / generate_image / write_code tools
# and the canvas side panel. See the "Generation" section in
# backend/app.py.
EASTA_ENABLE_GENERATION=true
# Server-side voice fallbacks (see EASTA_STT_MODEL/EASTA_TTS_MODEL
# above). The frontend only uses these when the browser's own
# SpeechRecognition/speechSynthesis can't cover the request -- turning
# either of these off just means the mic button / "Read aloud" fall
# back further to "browser only" (or hide, if the browser can't do it
# either) rather than erroring.
EASTA_ENABLE_SERVER_STT=true
EASTA_ENABLE_SERVER_TTS=true

# --- Error tracking (Phase 26) ---
# Leave blank to run with no Sentry integration at all (the app works
# identically either way -- errors still print to stdout as always).
# Get a DSN from https://sentry.io -> Settings -> Projects -> <project>
# -> Client Keys (DSN). The same DSN also goes in frontend/.env for the
# browser-side SDK -- Sentry DSNs are meant to be public/embeddable in
# client code, unlike an API key.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0 = errors only, no performance traces (traces have separate Sentry
# quota/cost from error events). A number from 0 to 1, e.g. 0.1 for 10%
# of requests traced.
SENTRY_TRACES_SAMPLE_RATE=0
