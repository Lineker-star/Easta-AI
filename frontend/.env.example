# Copy this file to .env and fill in real values.
BACKEND_URL=http://localhost:8000

# --- Error tracking (Phase 26) ---
# Leave blank to run with no Sentry integration (both server-side
# Flask errors here and browser-side JS errors via _sentry_init.html).
# Same DSN as backend/.env -- see the comment there for where to get
# one. This one is also shipped to the browser (via a small inline
# script -- see _sentry_init.html), which is expected: a Sentry DSN is
# meant to be public/embeddable in client-side code, unlike an API key.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
