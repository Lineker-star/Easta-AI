# Copy this file to .env (in this e2e/ directory) and fill in real
# values. This suite talks to an already-running EASTA stack -- it
# does not start Postgres/backend/frontend itself. See README.md.

# The Flask frontend the browser navigates to.
E2E_BASE_URL=http://localhost:5000
# The FastAPI backend -- used directly by tests/google-signin.spec.js
# to hit the mocked OAuth callback (see backend's
# EASTA_E2E_MOCK_GOOGLE_OAUTH below).
E2E_BACKEND_URL=http://localhost:8000
